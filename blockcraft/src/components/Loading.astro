---
import { SITE } from '../config/site.config.js';
---
<div class="loading" id="loading">
  <div class="loading-in">
    <div class="loading-title">{SITE.worldName}</div>
    <div class="loading-sub">Building terrain…</div>
    <div class="loading-bar"><div class="loading-fill" id="loading-fill"></div></div>
    <div class="loading-tip">Tip: press <b>F3</b> for debug info</div>
  </div>
</div>
